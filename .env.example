# Supabase browser-safe project URL and publishable/anon key.
# Never put a service-role key or database password here.
SUPA_URL=https://your-project-ref.supabase.co
SUPA_KEY=your-supabase-anon-or-publishable-key

# Optional server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
